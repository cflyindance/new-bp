# .env.development

# Is it compatible with older browsers
VITE_LEGACY=false

# Whether to open mock
VITE_USE_MOCK=false

# Delete console
# VITE_DROP_CONSOLE=false

# Whether to generate sourcemap
VITE_BUILD_SOURCEMAP=false

# Whether to enable gzip or brotli compression
# Optional: gzip | brotli | none
VITE_BUILD_COMPRESS='none'

# POS Server Address 如果想连接别人的pos地址 换这个
# VITE_SERVER_URL=http://192.168.252.154:22080/kpos/
# socket center http://153.3.250.178:28080/kpos/front2/myhome.html
VITE_SERVER_URL=http://localhost:22080/kpos/

# Whether to enable image compression
VITE_ENABLE_IMAGEMIN=false

# Whether to report build stats
VITE_BUILD_REPORT=false

# Whether to watch build
VITE_BUILD_WATCH=false

# Whether to use pwa
VITE_USE_PWA=true

# Whether to use vConsole
VITE_USE_VCONSOLE=false
