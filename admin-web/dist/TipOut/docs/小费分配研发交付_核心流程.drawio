<mxfile host="app.diagrams.net"><diagram id="tipout-core" name="核心流程"><mxGraphModel dx="1600" dy="660" grid="1" gridSize="10" page="1" pageWidth="1600" pageHeight="660"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="s1" value="固定计算范围&#xa;门店日／规则版本&#xa;订单与考勤事实" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eef4ff;strokeColor=#5b8def;fontSize=16;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="150" height="100" as="geometry"/></mxCell>
