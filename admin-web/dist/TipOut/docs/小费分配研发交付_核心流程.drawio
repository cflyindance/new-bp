<mxCell id="note0" value="小费分配：需求 → 资金 → 接收 → 确认 → 发放" style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=28;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="40" y="35" width="1500" height="50" as="geometry"/></mxCell>
<mxCell id="note1" value="贡献不足老板补足，超预算全额入池；确认记录不代表实际付款。" style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontColor=#334155;" vertex="1" parent="1"><mxGeometry x="40" y="95" width="1500" height="40" as="geometry"/></mxCell>
