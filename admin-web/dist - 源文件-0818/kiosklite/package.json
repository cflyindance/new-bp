  "license": "ISC",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "npm@11.9.0",
  "browserslist": {
    "production": [
      ">=0.01%",
      "not dead",
      "Android >= 4.4",
      "iOS >= 9",
      "Safari >= 9",
      "Chrome >= 60"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "jest": {
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    }
